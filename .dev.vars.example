# Local secrets for the Cloudflare build (`npm run dev:d1`, `npm run preview:d1`). Copy to .dev.vars (git-ignored).
# Production values are set as Worker secrets: npx wrangler secret put <NAME>   (never commit real values)

# Required for the guestbook: long random string (salts IP hashes, signs form tokens). e.g. `openssl rand -hex 32`
GUESTBOOK_IP_SALT=
# Optional: moderation token sign-in when Cloudflare Access isn't configured (24+ characters)
GUESTBOOK_ADMIN_TOKEN=
# Optional: lets a low-cost OpenRouter model answer "Ask the leopard" questions (/api/leopard). Without it, answers come
# from site entries. OPENROUTER_MODEL optionally picks the first model to try (default google/gemini-2.5-flash-lite).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
