# Guestbook (server-only; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to sign in at /guestbook/admin
GUESTBOOK_ADMIN_TOKEN=
# Long random string used to hash IPs and sign form tokens
GUESTBOOK_IP_SALT=
# "true" publishes entries immediately (spam heuristics still apply); default is review first
GUESTBOOK_AUTO_APPROVE=false
