{
  "name": "mojeebfolio",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "preview": "npm run build:vinext && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:check": "vinext-cloudflare deploy --config dist/server/wrangler.json --dry-run",
    "cf-typegen": "wrangler types --include-runtime=false worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply mojeeb-guestbook --local",
    "og:assets": "node scripts/og-assets.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.1.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8",
    "typescript": "^5",
    "vinext": "^1.2.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
